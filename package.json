{
  "name": "dsh-waaagh-ork",
  "version": "0.2.0",
  "description": "WAAAGH! — a green pixel-Ork mascot plugin for DSH Web and DSH Desktop: masks the model's thinking + output as green \"Waaaaaaagh!!!\" (click to reveal the original), a random-length input mask, and a \"Deep diving\" → \"Waaaaaaagh!!!\" running indicator.",
  "license": "MIT",
  "type": "module",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "main": "lib/index.js",
  "exports": {
    ".": {
      "default": "./lib/index.js"
    },
    "./client": {
      "default": "./lib/client.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "lib/index.js",
    "lib/client.js",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/oopsylol/dsh-waaagh-ork.git"
  },
  "bugs": {
    "url": "https://github.com/oopsylol/dsh-waaagh-ork/issues"
  },
  "homepage": "https://github.com/oopsylol/dsh-waaagh-ork#readme",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "dsh-desktop",
    "waaagh",
    "ork",
    "warhammer",
    "mascot",
    "pixel-art"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-slots",
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-settings-general"
      ]
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.2",
    "@deepseek-ai/dsh-client-ui-conversation": ">=0.1.6-alpha.2 <0.2.0",
    "@deepseek-ai/dsh-client-ui-settings-general": ">=0.1.6-alpha.2 <0.2.0",
    "@deepseek-ai/dsh-client-ui-slots": ">=0.1.0-rc.5 <0.2.0",
    "react": "^18.2.0"
  }
}
